:root{
  --tfx-accent:#ff8c00;
  --tfx-ink:#111;
  --tfx-sub:#444;
  --tfx-line: rgba(0,0,0,0.06);
  --tfx-ok:#0a9b63;
  --tfx-bad:#d92c2c;
}

.tfx-p{ line-height:1.9; color:var(--tfx-sub); }
.tfx-strong{ font-weight:900; color:var(--tfx-ink); }

.ui-callout{
  border-radius:22px;
  background:linear-gradient(180deg,#fff,rgba(255,140,0,0.05));
  border:1px solid var(--tfx-line);
  box-shadow:0 14px 30px rgba(0,0,0,0.05);
  padding:14px;
  margin-top:12px;
  position:relative;
  overflow:hidden;
}
.ui-callout:before{
  content:"";
  position:absolute;
  right:-40px;
  top:-40px;
  width:150px;
  height:150px;
  border-radius:999px;
  background:rgba(255,140,0,0.10);
}
.ui-callout .k{
  display:inline-flex;
  align-items:center;
  gap:8px;
  font-weight:950;
  color:#111;
  margin-bottom:6px;
}
.ui-pill{
  display:inline-flex;
  padding:6px 10px;
  border-radius:999px;
  background:rgba(255,140,0,0.10);
  border:1px solid rgba(255,140,0,0.22);
  font-size:13px;
  font-weight:850;
}

.ui-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:12px;
  margin-top:12px;
}
@media(max-width:980px){ .ui-grid{ grid-template-columns:1fr; } }

.ui-card{
  border-radius:22px;
  background:#fff;
  border:1px solid var(--tfx-line);
  box-shadow:0 14px 30px rgba(0,0,0,0.05);
  padding:12px 14px;
}

.ui-badge{
  width:38px;
  height:38px;
  border-radius:16px;
  display:flex;
  align-items:center;
  justify-content:center;
  color:#fff;
  font-weight:900;
}
.ui-badge.ok{ background:var(--tfx-ok); }
.ui-badge.bad{ background:var(--tfx-bad); }

.ui-mini-table{
  margin-top:12px;
  border-radius:22px;
  overflow:hidden;
  border:1px solid var(--tfx-line);
}
.ui-mini-table .row{
  display:grid;
  grid-template-columns:170px 1fr;
  border-top:1px solid var(--tfx-line);
}
.ui-mini-table .row:first-child{ border-top:none; }
.ui-mini-table .k{
  padding:12px;
  font-weight:900;
  background:rgba(255,140,0,0.06);
}
.ui-mini-table .v{
  padding:12px;
}

@media(max-width:980px){
  .tfx-post-shell{ display:block; padding:14px; }
  .tfx-sidebar{ margin-top:20px; position:static !important; }
